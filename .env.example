# Runtime: Neon pooled connection, app_runtime role (no schema ownership / BYPASSRLS).
DATABASE_URL=
# Schema push only: owner's connection; Neon pooled URLs are converted to direct.
DATABASE_ADMIN_URL=
# Operator-owned API credentials only. Never use Business customer keys or subscription tokens.
OPERATOR_OPENAI_API_KEY=
OPERATOR_AI_GATEWAY_API_KEY=
# Explicit capability catalog/funding evidence; see docs/ai-profiles.md. No live defaults.
AI_CONFIGURATION_JSON=
# Neon connections explicitly use sslmode=verify-full (also normalized by the app).
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters. Never commit credentials.
BETTER_AUTH_SECRET=
# Resend key and verified sender; there is no console-link or live-send fallback.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Private files remain unavailable until EVERY setting is supplied/confirmed.
# Use a bucket CREATED in the US jurisdiction; location hints are insufficient.
# Confirm both r2.dev and public custom domains are disabled. Bucket-scoped R2 object-read/write credentials only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_US_CONFIRMED=
# Operator-chosen JSON, without defaults or account allowances. See docs/private-files.md.
FILE_POLICY_JSON=
# Set true only after deploying/attaching and verifying the cleanup schedule.
FILE_CLEANUP_SCHEDULE_CONFIRMED=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Operator-selected Trigger recovery cron. Deploy/attach it and verify its runs
# before confirming worker readiness. No live provider is activated by this flag.
TRIGGER_DISCOVERY_RECOVERY_CRON=
DISCOVERY_WORKER_DEPLOYMENT_CONFIRMED=
# Exa remains off until #2 is completed and the actual executed scope, quote,
# account capabilities/limits and Business policies are recorded. No defaults.
EXA_LIVE_ENABLED=false
OPERATOR_EXA_API_KEY=
EXA_ACTIVATION_JSON=

# Separate Google Calendar OAuth web client (not Google sign-in or Gmail).
# Enable only after actual OAuth/project approval and supported account setup.
# See docs/google-calendar.md. All settings are server-only; no NEXT_PUBLIC values.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_APPROVED=false
# Active AES-256-GCM key identifier and JSON map of key IDs to random 64-hex keys.
# Retain old keys during rotation until persisted credentials/states are re-encrypted or expired.
GOOGLE_CALENDAR_TOKEN_KEY_ID=
GOOGLE_CALENDAR_TOKEN_KEYS=

# Gmail is separate from Calendar and app sign-in. See docs/gmail.md.
# Approval flags require recorded production verification, assessment, account and cost prerequisites.
# Do not set these flags or activate a worker merely to run deterministic tests.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_APPROVED=false
GMAIL_PRODUCTION_PREREQUISITES_CONFIRMED=false
GMAIL_TOKEN_KEY_ID=
GMAIL_TOKEN_KEYS=
MAILBOX_WORKER_DEPLOYMENT_CONFIRMED=false

# Separate Microsoft Calendar confidential Web app, supporting workforce and personal accounts.
# See docs/microsoft-calendar.md; approval must reflect actual app/account setup.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_APPROVED=false
MICROSOFT_CALENDAR_TOKEN_KEY_ID=
MICROSOFT_CALENDAR_TOKEN_KEYS=
