# Runtime: Neon pooled connection, app_runtime role (no schema ownership / BYPASSRLS).
DATABASE_URL=
# Schema push only: owner's connection; Neon pooled URLs are converted to direct.
DATABASE_ADMIN_URL=
# Neon connections explicitly use sslmode=verify-full (also normalized by the app).
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters. Never commit credentials.
BETTER_AUTH_SECRET=
# Resend key and verified sender; there is no console-link or live-send fallback.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Private files remain unavailable until EVERY setting is supplied/confirmed.
# Use a bucket CREATED in the US jurisdiction; location hints are insufficient.
# Confirm both r2.dev and public custom domains are disabled. Bucket-scoped R2 object-read/write credentials only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_US_CONFIRMED=
# Operator-chosen JSON, without defaults or account allowances. See docs/private-files.md.
FILE_POLICY_JSON=
# Set true only after deploying/attaching and verifying the cleanup schedule.
FILE_CLEANUP_SCHEDULE_CONFIRMED=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
