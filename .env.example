# Runtime: Neon pooled connection, app_runtime role (no schema ownership / BYPASSRLS).
DATABASE_URL=
# Migrations only: Neon direct connection, schema owner with CREATE ROLE permission.
DATABASE_MIGRATION_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters. Never commit credentials.
BETTER_AUTH_SECRET=
# Resend key and verified sender; there is no console-link or live-send fallback.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
